{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug STM32F411 (OpenOCD)",
      "type": "cortex-debug",
      "request": "launch",
      "servertype": "openocd",
      "cwd": "${workspaceFolder}",

      "executable": "${workspaceFolder}/blink.elf",
      "preLaunchTask": "Build (make)",

      "configFiles": [
        "interface/stlink.cfg",
        "target/stm32f4x.cfg"
      ],

      "runToEntryPoint": "main",
      "device": "STM32F411RE",
      "svdFile": "${workspaceFolder}/svd/STM32F411.svd",

      "showDevDebugOutput": "none"
    }
  ]
}
